# Copy to server/.env (or set in your environment). Every value is optional for local development.

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Leave empty to use the embedded Postgres (PGlite)
# stored in server/.data/pglite — zero setup, ideal for demos.
DATABASE_URL=
# Where the embedded database lives when DATABASE_URL is empty.
# PGLITE_DIR=./.data/pglite

# --- Auth -----------------------------------------------------------------
# Secret for signing session tokens. REQUIRED in production (32+ random characters):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a random secret is generated on each start (sessions reset on restart).
JWT_SECRET=

# --- AI (Claude) ----------------------------------------------------------
# Server-side only; never exposed to the browser. Leave empty for offline mode
# (rule-based analysis + lesson-library tutor).
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# --- Server ---------------------------------------------------------------
# API port in development (the Vite dev server proxies /api to it). In production, PORT is used.
API_PORT=4000
# NODE_ENV=production

# Public address of the site (used in robots.txt and sitemap.xml). Optional: defaults to the request's host.
# PUBLIC_URL=https://noesis-ai.onrender.com
# Google Search Console "HTML tag" verification: paste only the content="..." value.
# GOOGLE_SITE_VERIFICATION=

# Password given to all demo accounts when seeding.
# DEMO_PASSWORD=EduGap@2026
